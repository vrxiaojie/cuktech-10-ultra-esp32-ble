# Target and diagnostics
CONFIG_IDF_TARGET_ESP32C3=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# BLE host: ESP32 is a Central / GATT Client, never the charger-facing server.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_GATT_SERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# MiOT login uses application-layer HKDF/HMAC/AES-CCM, not BLE pairing or
# bonding. The gateway uses legacy scanning and owns its reconnect policy.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_GAP_SERVICE=n
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=5
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=2

# Home Assistant compatibility currently targets MQTT 3.1.1.
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_PROTOCOL_5=n
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n
CONFIG_MQTT_SKIP_PUBLISH_IF_DISCONNECTED=y
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_BUFFER_SIZE=512
CONFIG_MQTT_TASK_STACK_SIZE=4096
CONFIG_MQTT_EVENT_QUEUE_SIZE=2
CONFIG_WS_TRANSPORT=n
# Provisioning, management, MQTT and mDNS currently use IPv4 only. Disabling
# IPv6 removes unused neighbour-discovery and IPv6 socket code.
CONFIG_LWIP_IPV6=n
# Phase one targets WPA2-Personal networks. WPA3/SAE/OWE and GMAC are not
# required by the gateway and add measurable flash cost on ESP32-C3.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_ENABLE_SAE_H2E=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_GMAC_SUPPORT=n
# Keep the IDF default enterprise component selection for compatibility with
# the ESP-TLS/mbedTLS link graph. The application does not expose 802.1X
# credentials or configure enterprise Wi-Fi.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=y
# Phase one uses plain MQTT/HTTP only. Keep mbedTLS crypto primitives for
# MiOT, but omit TLS roles and the root certificate bundle from firmware.
CONFIG_MBEDTLS_TLS_SERVER_AND_CLIENT=n
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_TLS_SERVER_ONLY=n
CONFIG_MBEDTLS_TLS_DISABLED=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_ERROR_STRINGS=n
CONFIG_MBEDTLS_FS_IO=n
CONFIG_MBEDTLS_HKDF_C=y
